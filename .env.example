# Copy to .env.local for local development, and set the same variables in Vercel (Project → Settings → Environment Variables).

# Backend API base URL, including /apiv1 (use the backend's stable production domain, not a per-deployment URL)
VITE_API_URL=http://localhost:8080/apiv1

# Google reCAPTCHA v3 site key (public). Add your Vercel domain(s) to the key's allowed domains in the reCAPTCHA admin console.
VITE_RECAPTCHA_SITE_KEY=6Lev8TEsAAAAANCfz2s5Ms7F8YuTCmIwCuxdXY3b

# Contact details shown on the site and used for WhatsApp / email fallbacks
VITE_WHATSAPP_NUMBER=21652677764
VITE_CONTACT_EMAIL=commercial@aisgroup.tn
VITE_CONTACT_PHONE=+216 74 461 168

# --- Build-time only (not exposed to the browser) ---
# Public address of the site, used for canonical URLs, hreflang, sitemap.xml, robots.txt and structured data.
# If unset on Vercel, the production *.vercel.app domain is used. Set it as soon as the real domain is connected.
SITE_URL=https://www.your-domain.com

# Google Search Console HTML-tag verification code (content of the google-site-verification meta tag). Optional.
GOOGLE_SITE_VERIFICATION=
